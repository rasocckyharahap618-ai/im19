{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"UGAI Task Plan",
  "type":"object",
  "required":["task_id","mode","task","steps","assumptions","abort_conditions"],
  "properties":{
    "task_id":{"type":"string","minLength":1},
    "mode":{"enum":["PLANNED","ORCHESTRATED","DYNAMIC"]},
    "task":{"type":"string","minLength":1},
    "steps":{"type":"array","maxItems":50,"items":{"type":"object","required":["id","tool","args","expected_evidence","on_failure"],"properties":{"id":{"type":"integer","minimum":0},"tool":{"type":"string","minLength":1},"args":{"type":"object"},"expected_evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"on_failure":{"enum":["abort","retry_once","skip"]}}}},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "abort_conditions":{"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "additionalProperties":false
}

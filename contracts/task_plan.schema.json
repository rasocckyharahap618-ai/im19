{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://im19.local/contracts/task_plan.schema.json",
  "title": "UGAI Agent v3 Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "task", "steps", "assumptions", "abort_conditions"],
  "allOf": [
    {"if": {"properties": {"mode": {"const": "PLANNED"}}, "required": ["mode"]}, "then": {"properties": {"steps": {"maxItems": 20}}}}
  ],
  "properties": {
    "mode": {"enum": ["PLANNED", "ORCHESTRATED", "DYNAMIC"]},
    "task": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "abort_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tool", "args", "expected_evidence", "on_failure"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "tool": {"type": "string", "minLength": 1},
        "args": {"type": "object"},
        "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "on_failure": {"enum": ["abort", "retry_once", "skip"]}
      }
    }}
  }
}
